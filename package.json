{
  "name": "@cycjimmy/config-lib",
  "type": "module",
  "version": "3.2.2",
  "description": "Personal collection of configs",
  "author": "cycjimmy <cycjimmy@gmail.com> (https://github.com/cycjimmy)",
  "license": "MIT",
  "homepage": "https://github.com/cycjimmy/config-lib#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cycjimmy/config-lib.git"
  },
  "bugs": {
    "url": "https://github.com/cycjimmy/config-lib/issues"
  },
  "keywords": [
    "collection",
    "config"
  ],
  "exports": {
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "trash dist && npm run build:types && npm run build:js",
    "build:types": "tsc -p tsconfig.build.json",
    "build:js": "vite build",
    "package": "trash .release && npm run build && node tasks/copyFiles.ts && node tasks/handlePackageJson.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.13.0",
    "fs-extra": "^11.2.0",
    "jiti": "^2.7.0",
    "trash-cli": "^7.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
